module equilibrate_test_paths
  implicit none
  private

  public :: fixture_file

  character(len=*), parameter :: fixture_dir = '@CMAKE_CURRENT_SOURCE_DIR@'

contains

  pure function fixture_file(filename) result(path)
    character(len=*), intent(in) :: filename
    character(len=:), allocatable :: path

    path = fixture_dir//'/'//filename
  end function

end module
